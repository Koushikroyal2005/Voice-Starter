# Copy to .env.compose (ignored). This file contains no application/provider keys.
# Set a strong local database password; preserve it across named-volume restarts.
POSTGRES_PASSWORD=
# Required only when the redis profile is used.
REDIS_PASSWORD=
# Local development uses the development-only token route; never expose publicly.
FRONTEND_TARGET=development
FRONTEND_ENV_FILE=.env.local
BACKEND_ENV_FILE=backend/.env
# Optional URL-encoded overrides if passwords contain reserved URL characters.
# WORKER_DATABASE_URL=postgresql+asyncpg://voice_starter:CHANGE_ME@postgres:5432/voice_starter
# WORKER_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
