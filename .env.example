# Copy to root .env.local. Use the SAME values in backend/.env.
# The frontend always uses the local development-only /api/token endpoint.
# Do not prefix secrets with NEXT_PUBLIC_. No public demo fallback is used.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=
