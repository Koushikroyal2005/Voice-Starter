# Use the SAME LiveKit project as the Next.js frontend.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
STT_PROVIDER=deepgram
LLM_PROVIDER=openai_compatible
TTS_PROVIDER=cartesia
DEEPGRAM_API_KEY=replace-with-deepgram-api-key
LLM_API_KEY=replace-with-openai-or-compatible-provider-api-key
CARTESIA_API_KEY=replace-with-cartesia-api-key

# Only selected provider keys are required. OPENAI_API_KEY also supports Whisper
# and remains a backward-compatible fallback when LLM_API_KEY is blank.
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
GOOGLE_API_KEY=
ELEVEN_API_KEY=
MURF_API_KEY=

# Blank matches the frontend's default automatic dispatch.
# For named dispatch, set the SAME AGENT_NAME in root .env.local.
AGENT_NAME=
# Blank models/voice resolve to the selected provider's documented defaults.
STT_MODEL=
STT_LANGUAGE=en
STT_BASE_URL=
STT_ALLOW_BATCH=false
STT_REQUIRE_INTERIM=false
TURN_DETECTION=vad
LLM_MODEL=
LLM_BASE_URL=
TTS_MODEL=
TTS_VOICE=
# Blank uses app/agents/instructions.py. Quote a custom single-line prompt.
AGENT_INSTRUCTIONS=

# Explicit tool allowlist; set to an empty value to disable all tools.
# Omit to inherit the selected module defaults. An explicit blank disables tools.
# TOOL_ALLOWLIST=get_current_time,calculate_expression,time_and_calculate

# Optional external tools, not speech/LLM providers. See docs/mcp.md.
MCP_ENABLED=false
MCP_CONFIG_FILE=mcp.servers.json

# Trusted application module (not the LiveKit dispatch registration name).
USE_CASE=general_assistant

# Optional infrastructure (off by default; backend-only credentials).
PERSISTENCE_ENABLED=false
PERSIST_TRANSCRIPTS=false
DATABASE_URL=postgresql+asyncpg://voice_starter:CHANGE_ME@localhost:5432/voice_starter
DATA_REDACTION_KEY=
PERSISTENCE_OWNER_NAMESPACE=
REDIS_ENABLED=false
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
SESSION_CACHE_TTL_SECONDS=300
TOOL_RATE_LIMIT=0
RATE_LIMIT_WINDOW_SECONDS=60

# Metadata-only application telemetry. OTLP is an explicit HTTP /v1/traces endpoint.
VOICE_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=false
SENTRY_DSN=
PROVIDER_MAX_RETRIES=2
PROVIDER_TIMEOUT_SECONDS=10

# Optional native fallback; verify capabilities, tools, language and residency first.
# Same pattern is supported for STT_FALLBACK_* and TTS_FALLBACK_*.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_LANGUAGE=en
LLM_FALLBACK_COMPATIBLE=false
