# Copy to .env. Help: ../docs/provider-profiles.md

# Local LiveKit (development only; match root .env.local)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=

# API keys
GROQ_API_KEY=replace-with-groq-api-key
GOOGLE_API_KEY=replace-with-google-ai-studio-api-key
NVIDIA_API_KEY=

# Pipeline (models and voices come from YAML)
VOICE_PROFILE=groq_gemini
VOICE_PROFILE_ALLOW_OVERRIDES=false

# Application
USE_CASE=general_assistant
AGENT_INSTRUCTIONS=

# Optional services (disabled)
MCP_ENABLED=false
MCP_CONFIG_FILE=mcp.servers.json
PERSISTENCE_ENABLED=false
PERSIST_TRANSCRIPTS=false
REDIS_ENABLED=false

# Retries and monitoring
PROVIDER_MAX_RETRIES=2
PROVIDER_TIMEOUT_SECONDS=10
VOICE_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=false
SENTRY_DSN=

# Backup LLM (disabled)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_LANGUAGE=en
LLM_FALLBACK_COMPATIBLE=false

# Other provider keys (optional)
LLM_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
MURF_API_KEY=
