# BACKEND SETUP - copy this file to backend/.env and fill ONLY your private keys.
# Current local pipeline: Groq Whisper -> Groq GPT-OSS -> Google Gemini TTS.
# Frontend settings belong in the repository root .env.local, not here.
# Never commit backend/.env or put provider keys in NEXT_PUBLIC_* variables.

# --- 1. LOCAL LIVEKIT SERVER ---
# These are LiveKit's public development-only credentials, not production secrets.
# Use the SAME four values in root .env.local.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Blank = automatic dispatch. Not the assistant's display name.
AGENT_NAME=

# --- 2. REQUIRED PROVIDER KEYS: fill these two values ---
# Groq Console key: used by both Whisper STT and the LLM.
LLM_API_KEY=replace-with-groq-api-key
# Google AI Studio key: used by Gemini TTS.
GOOGLE_API_KEY=replace-with-google-ai-studio-api-key
# Reuse the Groq key above. Keep this alias AFTER LLM_API_KEY.
GROQ_API_KEY=${LLM_API_KEY}

# --- 3. SPEECH TO TEXT: microphone audio -> words ---
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
# Leave blank: this adapter already uses Groq's official endpoint.
STT_BASE_URL=
# Whisper is batch-only: final transcripts after a VAD pause, not interim words.
STT_ALLOW_BATCH=true
STT_REQUIRE_INTERIM=false
TURN_DETECTION=vad

# --- 4. LANGUAGE MODEL: words -> response ---
# Uses LLM_API_KEY from section 2.
LLM_PROVIDER=openai_compatible
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- 5. TEXT TO SPEECH: response -> audio ---
# Uses GOOGLE_API_KEY from section 2.
TTS_PROVIDER=gemini
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
TTS_LANGUAGE=en
# REQUIRED with the installed Google SDK/plugin; stable v1 rejects speechConfig.
GOOGLE_GENAI_API_VERSION=v1beta

# --- 6. ASSISTANT IDENTITY AND TOOLS ---
USE_CASE=general_assistant
# Blank = the selected use-case prompt. Quote a custom single-line prompt.
AGENT_INSTRUCTIONS=
# Omit to inherit use-case tools. An explicit blank disables ALL tools.
# TOOL_ALLOWLIST=get_current_time,calculate_expression,time_and_calculate

# --- 7. OPTIONAL MCP: external tools (disabled) ---
# Not an STT/LLM/TTS provider. No MCP server needed for basic voice.
MCP_ENABLED=false
MCP_CONFIG_FILE=mcp.servers.json

# --- 8. OPTIONAL POSTGRESQL: permanent storage (disabled) ---
PERSISTENCE_ENABLED=false
PERSIST_TRANSCRIPTS=false
DATABASE_URL=postgresql+asyncpg://voice_starter:CHANGE_ME@localhost:5432/voice_starter
DATA_REDACTION_KEY=
PERSISTENCE_OWNER_NAMESPACE=

# --- 9. OPTIONAL REDIS: temporary state/cache (disabled) ---
REDIS_ENABLED=false
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
SESSION_CACHE_TTL_SECONDS=300
# Zero disables the application tool rate limit.
TOOL_RATE_LIMIT=0
RATE_LIMIT_WINDOW_SECONDS=60

# --- 10. OPTIONAL OBSERVABILITY AND PROVIDER RETRIES ---
# Blank endpoints = no external tracing/error reporting.
# OTLP, if enabled, must be an HTTP endpoint ending in /v1/traces.
VOICE_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=false
SENTRY_DSN=
PROVIDER_MAX_RETRIES=2
PROVIDER_TIMEOUT_SECONDS=10

# --- 11. OPTIONAL BACKUP LLM: disabled ---
# Example use: a separately verified NVIDIA OpenAI-compatible endpoint.
# This is the BACKUP provider's key, not your primary Groq key.
# A key alone does not enable fallback. Do not set compatible=true without testing.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_LANGUAGE=en
LLM_FALLBACK_COMPATIBLE=false
# Equivalent STT_FALLBACK_* / TTS_FALLBACK_* settings are optional; see provider guide.

# --- 12. OTHER PROVIDER KEYS: NOT needed for the active setup ---
# Fill a key only if you deliberately select that provider.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
MURF_API_KEY=
# OpenAI Whisper / optional legacy LLM key fallback (not a Groq key).
OPENAI_API_KEY=

# Switching profiles? Follow docs/first-voice-conversation.md.
# Gemini streaming STT and Groq batch STT need different capability flags.
# Groq Orpheus TTS additionally requires model-terms acceptance in Groq Console.
