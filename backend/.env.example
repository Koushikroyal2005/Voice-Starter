# Use the SAME LiveKit project as the Next.js frontend.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
STT_PROVIDER=deepgram
LLM_PROVIDER=openai_compatible
TTS_PROVIDER=cartesia
DEEPGRAM_API_KEY=replace-with-deepgram-api-key
LLM_API_KEY=replace-with-openai-or-compatible-provider-api-key
CARTESIA_API_KEY=replace-with-cartesia-api-key

# Only selected provider keys are required. OPENAI_API_KEY also supports Whisper
# and remains a backward-compatible fallback when LLM_API_KEY is blank.
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
GOOGLE_API_KEY=
ELEVEN_API_KEY=
MURF_API_KEY=

# Blank matches the frontend's default automatic dispatch.
# For named dispatch, set the SAME AGENT_NAME in root .env.local.
AGENT_NAME=
# Blank models/voice resolve to the selected provider's documented defaults.
STT_MODEL=
STT_LANGUAGE=en
STT_BASE_URL=
STT_ALLOW_BATCH=false
STT_REQUIRE_INTERIM=false
TURN_DETECTION=vad
LLM_MODEL=
LLM_BASE_URL=
TTS_MODEL=
TTS_VOICE=
# Blank uses app/agents/instructions.py. Quote a custom single-line prompt.
AGENT_INSTRUCTIONS=

# Explicit tool allowlist; set to an empty value to disable all tools.
TOOL_ALLOWLIST=get_current_time,calculate_expression,time_and_calculate
