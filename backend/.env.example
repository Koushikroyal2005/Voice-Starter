# Copy to backend/.env. Keep credentials private; never use NEXT_PUBLIC_* here.
# Local pipeline: Groq Whisper -> Groq LLM -> Gemini TTS.
# See docs/provider-profiles.md for catalog defaults and all profiles.

# 1. LOCAL LIVEKIT: use these same four values in root .env.local.
# devkey/secret are public DEVELOPMENT-ONLY defaults.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=

# 2. PROVIDER KEYS: configure once. Only selected providers' keys are required.
GROQ_API_KEY=replace-with-groq-api-key
GOOGLE_API_KEY=replace-with-google-ai-studio-api-key
# Only needed for the nvidia_gemini profile:
NVIDIA_API_KEY=

# 3. VOICE PROFILE: supplies models, endpoints, voices and batch/streaming flags.
VOICE_PROFILE=groq_gemini
# Also available: gemini_only, nvidia_gemini.
# Conflicting overrides fail startup unless explicitly acknowledged:
VOICE_PROFILE_ALLOW_OVERRIDES=false

# 4. ASSISTANT: independent from the voice/provider profile.
USE_CASE=general_assistant
AGENT_INSTRUCTIONS=
# Omit to inherit tools. An explicit blank disables ALL tools.
# TOOL_ALLOWLIST=get_current_time,calculate_expression,time_and_calculate

# 5. OPTIONAL SERVICES: disabled by default; no extra infrastructure needed.
MCP_ENABLED=false
MCP_CONFIG_FILE=mcp.servers.json
PERSISTENCE_ENABLED=false
PERSIST_TRANSCRIPTS=false
REDIS_ENABLED=false
# Only configure these if deliberately enabling the corresponding service:
# DATABASE_URL=postgresql+asyncpg://voice_starter:CHANGE_ME@localhost:5432/voice_starter
# DATA_REDACTION_KEY=
# PERSISTENCE_OWNER_NAMESPACE=
# REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
# SESSION_CACHE_TTL_SECONDS=300
# TOOL_RATE_LIMIT=0
# RATE_LIMIT_WINDOW_SECONDS=60

# 6. OPTIONAL RELIABILITY / OBSERVABILITY: no external endpoints by default.
PROVIDER_MAX_RETRIES=2
PROVIDER_TIMEOUT_SECONDS=10
VOICE_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=false
SENTRY_DSN=

# 7. OPTIONAL BACKUP: never enabled merely because another provider key exists.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_LANGUAGE=en
LLM_FALLBACK_COMPATIBLE=false

# 8. ADVANCED / LEGACY: existing deployments can omit VOICE_PROFILE entirely.
# With a profile, remove stale settings; acknowledge intentional overrides first.
# VOICE_PROFILE_ALLOW_OVERRIDES=true
# TTS_MODEL=gemini-3.1-flash-tts-preview
# TTS_VOICE=Puck
# STT_PROVIDER, STT_MODEL, STT_ALLOW_BATCH, STT_REQUIRE_INTERIM, TURN_DETECTION,
# LLM_PROVIDER, LLM_MODEL, LLM_BASE_URL and TTS_PROVIDER remain supported.
# LLM_PROVIDER=openai_compatible uses LLM_API_KEY (or legacy OPENAI_API_KEY),
# rather than the vendor alias keys used by profiles.
# Gemini's v1beta setting is derived automatically when using a Google profile.
# Legacy env-only Google speech setups still need GOOGLE_GENAI_API_VERSION=v1beta.

# Keys for other existing adapters, only when deliberately selected:
LLM_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
MURF_API_KEY=
