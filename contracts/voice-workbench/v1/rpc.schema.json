{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-starter.invalid/contracts/voice-workbench/v1/rpc.schema.json",
  "title": "WorkbenchRpc",
  "description": "Catalog only: method is LiveKit metadata; request/response bodies are sent separately.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "request", "response"],
      "properties": {
        "method": { "const": "voice.interrupt" },
        "request": { "$ref": "#/$defs/emptyRequest" },
        "response": { "$ref": "#/$defs/interrupted" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "request", "response"],
      "properties": {
        "method": { "const": "voice.confirm_tool" },
        "request": { "$ref": "#/$defs/confirmationRequest" },
        "response": { "$ref": "#/$defs/accepted" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "request", "response"],
      "properties": {
        "method": { "const": "voice.tools_state" },
        "request": { "$ref": "#/$defs/emptyRequest" },
        "response": { "$ref": "#/$defs/toolsState" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "request", "response"],
      "properties": {
        "method": { "const": "voice.usecase_config" },
        "request": { "$ref": "#/$defs/emptyRequest" },
        "response": { "$ref": "#/$defs/publicUseCase" }
      }
    }
  ],
  "$defs": {
    "emptyRequest": { "title": "EmptyRequest", "type": "object", "additionalProperties": false },
    "confirmationRequest": {
      "title": "ConfirmationRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_id", "approved"],
      "properties": { "confirmation_id": { "type": "string" }, "approved": { "type": "boolean" } }
    },
    "accepted": {
      "title": "Accepted",
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": { "accepted": { "const": true } }
    },
    "interrupted": {
      "title": "Interrupted",
      "type": "object",
      "additionalProperties": false,
      "required": ["interrupted"],
      "properties": { "interrupted": { "const": true } }
    },
    "toolsState": {
      "title": "ToolsState",
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "events.schema.json#/$defs/toolEvent" }
    },
    "publicUseCase": {
      "title": "PublicUseCase",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "name",
        "description",
        "languages",
        "result_card_types",
        "notice"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "events.schema.json#/$defs/cardType" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,23}$" }
        },
        "result_card_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "events.schema.json#/$defs/cardType" }
        },
        "notice": { "type": "string", "maxLength": 400 }
      }
    },
    "rpcError": {
      "title": "WorkbenchRpcError",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": [1400, 2001, 2002, 2003, 2004, 2005, 2006] },
        "message": { "type": "string", "maxLength": 256 },
        "data": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
